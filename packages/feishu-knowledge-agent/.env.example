PORT=8788
PUBLIC_BASE_URL=https://your-domain.example.com

# Feishu custom app credentials.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx
FEISHU_VERIFICATION_TOKEN=xxx
# Optional. If set, request signatures are verified.
FEISHU_ENCRYPT_KEY=

# Optional Feishu Bitable sink. The bot still works with the local JSON store if these are empty.
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# Optional browsable Feishu doc. Create it once with `npm run doc:create`, then paste the id here.
# The doc is rebuilt from .knowledge/records.json after every archive.
FEISHU_DOC_ID=
# Folder the doc is created in. Leave empty for the app's root folder.
FEISHU_DOC_FOLDER_TOKEN=
FEISHU_FIELD_TITLE=Title
FEISHU_FIELD_SUMMARY=Summary
FEISHU_FIELD_CATEGORY=Category
FEISHU_FIELD_TAGS=Tags
FEISHU_FIELD_SOURCE_URL=Source URL
FEISHU_FIELD_SOURCE_TYPE=Source Type
FEISHU_FIELD_USE_CASES=Use Cases
FEISHU_FIELD_CREATED_AT=Created At

# Pi runner. Set this to the pi binary you want this service to call.
PI_AGENT_BINARY=pi
PI_AGENT_TIMEOUT_MS=120000

# LLM analysis. OpenAI-compatible API; used before the Pi runner when configured.
MARK_LLM_BASE_URL=https://thebestai.net/v1
MARK_LLM_API_KEY=
MARK_LLM_MODEL=deepseek-chat
MARK_LLM_TIMEOUT_MS=120000

# X/Twitter. Required for reliable post body, author, media, and metrics extraction.
X_BEARER_TOKEN=

# Bilibili subtitle extraction. Calls the Bilibili web APIs directly; no Python needed.
# Credentials come from these variables, or from BILIBILI_CONFIG_FILE when they are empty.
BILIBILI_SESSDATA=
BILIBILI_BILI_JCT=
BILIBILI_BUVID3=
BILIBILI_CONFIG_FILE=
BILIBILI_TIMEOUT_MS=20000
# Optional custom override. Command must print JSON to stdout and may use {url}.
BILIBILI_TRANSCRIPT_COMMAND=

# Tencent Cloud server monitoring. Without these, Mark still reports local server status.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_SECURITY_TOKEN=
TENCENTCLOUD_REGION=ap-guangzhou
TENCENTCLOUD_CVM_INSTANCE_ID=
TENCENTCLOUD_CVM_INSTANCE_ALIAS=
# For multiple servers, prefer this format:
# TENCENTCLOUD_CVM_INSTANCES=ap-guangzhou:ins-xxxx:Mark主机,ap-shanghai:ins-yyyy:数据库
TENCENTCLOUD_CVM_INSTANCES=
TENCENTCLOUD_MONITOR_NAMESPACE=QCE/CVM
TENCENTCLOUD_MONITOR_DIMENSION_NAME=InstanceId
TENCENTCLOUD_MONITOR_METRICS=CpuUsage,CpuLoadavg,MemUsage,CvmDiskUsage,WanIntraffic,WanOuttraffic,TcpCurrEstab
TENCENTCLOUD_MONITOR_PERIOD=60
TENCENTCLOUD_MONITOR_WINDOW_MINUTES=10
TENCENTCLOUD_TIMEOUT_MS=10000

# Local fallback store.
KNOWLEDGE_DATA_DIR=.knowledge
